# ============================================================
# NYRA AI — ENVIRONMENT CONFIGURATION
# ============================================================
# This file documents all required environment variables.
# DO NOT commit actual secrets. Use this as a template only.
# ============================================================

# ============================================================
# SUPABASE
# ============================================================
# Get these from: https://app.supabase.com/project/[PROJECT_ID]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Service role key (for backend only — NEVER expose to frontend)
# Get from: https://app.supabase.com/project/[PROJECT_ID]/settings/api
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ============================================================
# REPLICATE (AI Generation)
# ============================================================
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# ============================================================
# STRIPE (Payments)
# ============================================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Webhook signing secret
# Get from: https://dashboard.stripe.com/webhooks
# Used to verify webhook signatures from Stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# SITE CONFIGURATION
# ============================================================
# The public-facing URL of your site
# Used for Stripe redirects and email links
NEXT_PUBLIC_SITE_URL=https://webnyra.com

# ============================================================
# NOTES
# ============================================================
# - NEXT_PUBLIC_* variables are exposed to the browser
# - Other variables are backend-only (use in API routes and RPC)
# - Update this file when adding new configuration
# - Never commit secrets to git (see .gitignore)
